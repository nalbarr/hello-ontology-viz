# Path where the rendered ontology visualization image is written.
# Defaults to output/<ontology>_ontology_hierarchy.png based on ONTOLOGY_VIZ_ONTOLOGY.
# Uncomment to override:
# ONTOLOGY_VIZ_OUTPUT_PATH=output/pizza_ontology_hierarchy.png

# Graph construction backend: networkx (matplotlib rendering) or rustworkx (graphviz rendering)
ONTOLOGY_VIZ_GRAPH_BACKEND=networkx

# Which sample ontology to load: pizza or chemistry
ONTOLOGY_VIZ_ONTOLOGY=pizza
